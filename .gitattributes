# Every text file is stored as LF and checked out as LF, on every platform.
#
# This matters most for `lib/`: it is committed (so a clone or a `github:`
# install needs no build step) but it is a generated artifact, and a CRLF
# checkout would make the working copy differ from what `scripts/build.mjs`
# wrote and from what the host loads. Pinning LF keeps a round-trip through Git
# byte-identical, which is what makes "the served bundle equals the built one"
# checkable at all.
* text=auto eol=lf

# Windows-native scripts, if any are ever added, keep their own line endings.
*.cmd text eol=crlf
*.bat text eol=crlf

# `lib/` is generated by `scripts/build.mjs` from `src/`. Marking it as generated
# lets review tools fold it away instead of presenting it as hand-written source:
# GitHub collapses it, and a local diff can skip it with
# `git diff -- . ':(exclude)lib'`. It is still tracked, and still shipped.
lib/** linguist-generated=true
