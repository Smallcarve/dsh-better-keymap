# Project-local pnpm settings.
#
# `node-linker=hoisted` is required, and this file is the only place pnpm reads
# it from — `pnpm.nodeLinker` in package.json is ignored. The isolated linker
# hides the transitive dependencies of the bundled devDependencies (`ansis`,
# `@rolldown/pluginutils`, `lightningcss`), and `scripts/build.mjs` then fails
# to resolve them.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
